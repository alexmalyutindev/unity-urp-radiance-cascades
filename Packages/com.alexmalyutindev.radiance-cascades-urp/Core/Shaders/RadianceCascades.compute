#pragma kernel RenderAndMergeCascade
#pragma kernel CombineSH

/////////////////////
/// CONFIGURATION ///
/////////////////////

// #define SELF_OCCLUSION
// #define TRACE_BEFORE_SH
// #define FOUR_CHILD_RAYS

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/GlobalSamplers.hlsl"

// TODO: Move all RC code to ShaderLibrary, keep only Unity's wrapper in *.compute file.
#include "Packages/com.alexmalyutindev.radiance-cascades-urp/ShaderLibrary/Raytracing.hlsl"
#include "Packages/com.alexmalyutindev.radiance-cascades-urp/ShaderLibrary/SphericalHarmonics.hlsl"
#include "Packages/com.alexmalyutindev.radiance-cascades-urp/ShaderLibrary/BitMaskTracing.hlsl"

// Input
float _RayScale;
float _CascadeLevel;

float4 _ProbesCount;
float4 _CascadeSize; // _ProbesCount + Padding
float4 _CascadeBufferSize;

float4 _NextProbesCount;
float4 _NextCascadeSize;

float4 _SceneDepth_TexelSize;

Texture2D<float3> _SceneColor;
Texture2D<float> _SceneDepth;
Texture2D<float2> _MinMaxDepth;
Texture2D<float> _SmoothedDepth;

SAMPLER(sampler_VarianceDepth);
Texture2D<float2> _VarianceDepth;
SAMPLER(sampler_BlurredColor);
Texture2D<float3> _BlurredColor;

StructuredBuffer<float4> _SHCoefficients;

/////////////
// Outputs //
/////////////

// Cascade Layout:
// Columns - longitudinal rays
// Rows - latitudinal rays
//            min probes                      max probes
// ._______________________________v_______________________________.
// |   ↗   |   ↖   |   ↙   |   ↘   |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|_______|_______|_______|_______|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
RWTexture2D<half4> _RadianceCascades;

// Output
// ._____________.
// | SH0  | SH1x |
// |______|______|
// | SH1y | SH1z |
// |______|______|
RWTexture2D<half4> _RadianceSH;

///////////////
/// TRACING ///
///////////////

float2 GetDepthMoments(float2 uv)
{
    // _CascadeLevel = 0 is x1/4 of target resolution,
    // _VarianceDepth is x1/2 of target resolution, then offsetting mip level by 1.
    return SAMPLE_TEXTURE2D_LOD(_VarianceDepth, sampler_LinearClamp, uv, _CascadeLevel + 1).xy;
}

float3 GetSceneLighting(float2 uv)
{
    // _CascadeLevel = 0 is x1/4 of target resolution,
    // _BlurredColor is x1/2 of target resolution, then offsetting mip level by 1.
    return SAMPLE_TEXTURE2D_LOD(_BlurredColor, sampler_LinearClamp, uv, _CascadeLevel + 1).rgb;
}

float3 GetFullResSceneLighting(float2 uv)
{
    return SAMPLE_TEXTURE2D_LOD(_SceneColor, sampler_LinearClamp, uv, 0);
}

float LoadLinearDepth(int2 coords)
{
    return LinearEyeDepth(LOAD_TEXTURE2D_LOD(_SceneDepth, coords, 0), _ZBufferParams);
}

float SampleLinearDepth(float2 uv)
{
    return LinearEyeDepth(SAMPLE_TEXTURE2D_LOD(_SceneDepth, sampler_LinearClamp, uv, 0), _ZBufferParams);
}

///////////////

float4 GetRadianceWeighted(int2 coords, int2 offset, float4 weights)
{
    // TODO: Optimize boundary check!
    float4 a = _RadianceCascades[coords + offset];
    float4 b = _RadianceCascades[coords + int2(1, 0) + offset];
    float4 c = _RadianceCascades[coords + int2(0, 1) + offset];
    float4 d = _RadianceCascades[coords + int2(1, 1) + offset];

    return a * weights.x
        + b * weights.y
        + c * weights.z
        + d * weights.w;
}

float2 SampleMinMaxDepth(uint2 coords, float4 bilinearWeights, int mipLevel)
{
    static const int2 neighbours[4] = {int2(0, 0), int2(1, 0), int2(0, 1), int2(1, 1)};

    float2 minMaxDepthBilinear = float2(0.0f, 0.0f);
    UNITY_UNROLL for (int i = 0; i < 4; i++)
    {
        float2 minMaxDepth = LOAD_TEXTURE2D_LOD(_MinMaxDepth, coords + neighbours[i], mipLevel);
        minMaxDepthBilinear += minMaxDepth * bilinearWeights[i];
    }

    return minMaxDepthBilinear;
}

float2 GetRayDirection(uint2 coords, int cascadeIndex)
{
    float2 rayDirectionUV;

    // TODO: Fix hardcoded values.
    float cascadeFactor = 1 << cascadeIndex;
    float radialRaysCount = 8.0f * cascadeFactor;
    float angleId = floor(coords.x * radialRaysCount * _CascadeBufferSize.z);
    float deltaPhi = TWO_PI * pow(0.5f, _CascadeLevel) * 0.25f;
    sincos((angleId + 0.5f) * deltaPhi, rayDirectionUV.y, rayDirectionUV.x);

    return rayDirectionUV;
}

float3 GetEnvironmentLighting(float3 rayDirectionWS)
{
    // TODO: Sample environment cubemap
    return float3(0.0f, 0.0f, 0.0f);
    return SampleSH9(_SHCoefficients, rayDirectionWS);
}

/////////////////////////
/// CASCADE RENDERING ///
/////////////////////////

float2 GetSubRayDirection(uint rayCol, int cascadeIndex, uint subRayId)
{
    float nextRaysCount = 4.0f * (float)(2 << cascadeIndex);
    float angle = TWO_PI * ((float)(rayCol * 2u + subRayId) + 0.5f) / nextRaysCount;

    float2 directionUV;
    sincos(angle, directionUV.y, directionUV.x);
    return directionUV;
}

void TraceCascadeRay(
    float2 probeCenterUV,
    float2 probeMinMaxDepth,
    float2 rayDirectionUV,
    out half4x4 radianceMin,
    out half4x4 radianceMax
)
{
    int cascadeIndex = int(_CascadeLevel);

    RayTracingArgs tracingArgs;
    tracingArgs.probeCenterUV = probeCenterUV;
    tracingArgs.probeMinMaxDepth = probeMinMaxDepth;
    tracingArgs.rayDirection = rayDirectionUV * _ProbesCount.xx * _ProbesCount.zw;
    tracingArgs.sharpness = pow(2.0f, _CascadeLevel);
    tracingArgs.probeSize = _ProbesCount.z * _RayScale;
    tracingArgs.depthThickness = 40.0f;

    float spacing = 1 << cascadeIndex;
    float start = 1 + 3 * (pow(2, _CascadeLevel) - 1);
    float end = 1 + 3 * (pow(2, _CascadeLevel + 1) - 1);

    tracingArgs.tracingRange = float2(start, end) / spacing;
    tracingArgs.stepSize = 1.0f;

    RayTracing_TrapezoidIntegration(tracingArgs, radianceMin, radianceMax);
}

[numthreads(8, 4, 1)]
void RenderAndMergeCascade(uint3 id : SV_DispatchThreadID)
{
    uint2 coords = int2(id.xy);
    int cascadeIndex = int(_CascadeLevel);

    // NOTE: On each cascade we compute N screen oriented rays.
    uint2 probeCenterCoord = coords % int2(_CascadeSize.xy);

    // NOTE: Drop threads outside of cascade probes count.
    if (coords.y >= uint(_ProbesCount.y) || probeCenterCoord.x >= uint(_ProbesCount.x))
    {
        // NOTE: Offsetting coords to top
        uint2 targetCoords = int2(id.x, id.y + 7 * floor(_CascadeSize.y));
        UNITY_UNROLL for (int depthRayId = 0; depthRayId < 4; depthRayId++)
        {
            _RadianceCascades[targetCoords] = float4(1, 0, 1, 0);
            targetCoords.y -= _CascadeSize.y;
        }
        return;
    }

    float2 probeCenterUV = saturate(float2(probeCenterCoord + 0.5f) * _ProbesCount.zw);
    float2 probeMinMaxDepth = LOAD_TEXTURE2D_LOD(_MinMaxDepth, probeCenterCoord, _CascadeLevel + 1).xy;

    // Ray column of this thread in the current cascade (0 .. 4 * 2^c - 1).
    uint rayCol = (uint)floor(coords.x * _CascadeSize.z);

    int halfBufferWidth = (int)(_CascadeBufferSize.x * 0.5f);
    uint2 outputCoords = int2(id.x, id.y + 4 * floor(_CascadeSize.y));

    // Accumulated (averaged) result: [depth layer][depth sector].
    half4x4 result[2];
    result[0] = result[1] = 0.0h;

    if (_CascadeLevel < 4)
    {
        // Bilinear setup for the next cascade's probes (same for both sub-rays).
        float2 nextProbeContinuous = probeCenterUV * _NextProbesCount.xy - 0.5f;
        int2 nextProbeBaseId = (int2)floor(nextProbeContinuous);
        // TODO: Fix border samples!
        int2 nextProbeLocalId = clamp(nextProbeBaseId, 0, _NextProbesCount.xy - 2);

        float2 bilinearOffsets = nextProbeContinuous - nextProbeBaseId;
        float4 bilinearWeights = float4(bilinearOffsets, 1.0f - bilinearOffsets);
        bilinearWeights = bilinearWeights.zxzx * bilinearWeights.wwyy;

        // Depth layer blend between next cascade's min/max probes (same for both sub-rays).
        float2 nextMinMaxDepth = SampleMinMaxDepth(nextProbeLocalId, bilinearWeights, _CascadeLevel + 2);
        float depthThickness = max(1e-7f, abs(nextMinMaxDepth.y - nextMinMaxDepth.x));
        float2 depthLerp = saturate((probeMinMaxDepth - nextMinMaxDepth.x) / depthThickness);

        for (uint subRayId = 0; subRayId < 2u; subRayId++)
        {
            // 1. Trace this sub-ray with the current cascade's interval.
            float2 subRayDirectionUV = GetSubRayDirection(rayCol, cascadeIndex, subRayId);
            half4x4 radiances[2];
            TraceCascadeRay(probeCenterUV, probeMinMaxDepth, subRayDirectionUV, radiances[0], radiances[1]);

            // 2. Fetch exactly ONE parent ray: column (2 * rayCol + subRayId) of the next cascade.
            half4x4 parents[2]; // [depth layer][depth sector]
            parents[0] = parents[1] = 0.0h;

            UNITY_UNROLL for (int depthLayerId = 0; depthLayerId < 2; ++depthLayerId)
            {
                UNITY_UNROLL for (int depthSectorId = 0; depthSectorId < 4; depthSectorId++)
                {
                    int2 parentOffset = int2(
                        (int)(rayCol * 2u + subRayId) * (int)_NextCascadeSize.x + depthLayerId * halfBufferWidth,
                        (4 + depthSectorId) * (int)_NextCascadeSize.y
                    );

                    parents[depthLayerId][depthSectorId] =
                        GetRadianceWeighted(nextProbeLocalId, parentOffset, bilinearWeights);
                }
            }

            // 3. Merge this sub-ray with its parent, then accumulate the average of the two sub-rays.
            UNITY_UNROLL for (int depthSectorId = 0; depthSectorId < 4; depthSectorId++)
            {
                float4 parentMin = parents[0][depthSectorId];
                float4 parentMax = parents[1][depthSectorId];

                UNITY_UNROLL for (int depthLayerId = 0; depthLayerId < 2; ++depthLayerId)
                {
                    float4 parent = lerp(parentMin, parentMax, depthLerp[depthLayerId]);

                    float4 radiance = radiances[depthLayerId][depthSectorId];
                    radiance.rgb += parent.rgb * radiance.a;
                    radiance.a *= parent.a;

                    result[depthLayerId][depthSectorId] += radiance * 0.5h;
                }
            }
        }
    }
    else
    {
        // Last cascade: the "parent" is the environment, same sub-ray averaging.
        UNITY_UNROLL for (uint subRayId = 0; subRayId < 2u; subRayId++)
        {
            float2 subRayDirectionUV = GetSubRayDirection(rayCol, cascadeIndex, subRayId);
            half4x4 radiances[2];
            TraceCascadeRay(probeCenterUV, probeMinMaxDepth, subRayDirectionUV, radiances[0], radiances[1]);

            UNITY_UNROLL for (int depthSectorId = 0; depthSectorId < 4; depthSectorId++)
            {
                half rayDirectionZ = 1.0f - (depthSectorId + 0.5f) * 0.5f;
                // BUG: rayDirectionUV is stretched to screen aspect ratio!
                half3 rayDirectionVS = normalize(float3(subRayDirectionUV, rayDirectionZ));
                half3 rayDirectionWS = -mul((float3x3)_ViewToWorld, rayDirectionVS);
                float3 environmentLighting = GetEnvironmentLighting(rayDirectionWS);

                UNITY_UNROLL for (int depthLayerId = 0; depthLayerId < 2; ++depthLayerId)
                {
                    float4 radiance = radiances[depthLayerId][depthSectorId];
                    radiance.rgb += environmentLighting.rgb * radiance.a;

                    result[depthLayerId][depthSectorId] += radiance * 0.5h;
                }
            }
        }
    }

    // Write the averaged result: current cascade resolution (N_c rays), same layout as before.
    UNITY_UNROLL for (int depthSectorId = 0; depthSectorId < 4; depthSectorId++)
    {
        UNITY_UNROLL for (int depthLayerId = 0; depthLayerId < 2; ++depthLayerId)
        {
            int2 targetOffset = int2(depthLayerId * halfBufferWidth, _CascadeSize.y * depthSectorId);
            _RadianceCascades[outputCoords + targetOffset] = result[depthLayerId][depthSectorId];
        }
    }
}

///////////////////
/// RADIANCE SH ///
///////////////////

[numthreads(8, 4, 1)]
void CombineSH(uint3 id : SV_DispatchThreadID)
{
    int2 coords = id.xy;
    if (any(coords.xy >= int2(_ProbesCount.xy)))
    {
        _RadianceSH[coords] = float4(1.0f, 0.0f, 0.0f, 0.0f);
        return;
    }

    float2 probeCenterUV = (coords + 0.5f) * _ProbesCount.zw;

    int2 maxPixel = int2(_ScreenSize.xy) - 1;
    int2 probePixel = clamp(int2(probeCenterUV * _ScreenSize.xy), 0, maxPixel);
    float probeDepth = LoadLinearDepth(probePixel);

    float2 probeDepthSlope;
    {
        float depthL = LoadLinearDepth(clamp(probePixel - int2(1, 0), 0, maxPixel));
        float depthR = LoadLinearDepth(clamp(probePixel + int2(1, 0), 0, maxPixel));
        float depthD = LoadLinearDepth(clamp(probePixel - int2(0, 1), 0, maxPixel));
        float depthU = LoadLinearDepth(clamp(probePixel + int2(0, 1), 0, maxPixel));

        probeDepthSlope = float2(
            MinAbsSlope(probeDepth - depthL, depthR - probeDepth),
            MinAbsSlope(probeDepth - depthD, depthU - probeDepth)
        );
    }

    int2 nextCascadeSize = _NextCascadeSize.xy;

    // CHANGED: clamp the CONTINUOUS coordinate (as the reference does), so weights stay in [0, 1] at borders.
    // Before: base index was clamped but the fraction came from the unclamped value.
    float2 nextProbeContinuous = clamp(
        probeCenterUV * _NextProbesCount.xy - 0.5f,
        0.0f,
        _NextProbesCount.xy - 1.0f
    );
    int2 nextProbeLocalId = min((int2)floor(nextProbeContinuous), (int2)_NextProbesCount.xy - 2);

    float2 bilinearOffsets = nextProbeContinuous - nextProbeLocalId;
    float4 bilinearWeights = float4(bilinearOffsets, 1.0f - bilinearOffsets);
    bilinearWeights = bilinearWeights.zxzx * bilinearWeights.wwyy;

    int halfBufferWidth = (int)(_CascadeBufferSize.x * 0.5f);

    float2 nextMinMaxDepth = SampleMinMaxDepth(nextProbeLocalId, bilinearWeights, 1);
    float depthThickness = max(1e-7f, nextMinMaxDepth.y - nextMinMaxDepth.x);
    float depthLerp = depthThickness > 1e-6f ? saturate((probeDepth - nextMinMaxDepth.x) / depthThickness) : 0.5f;

    // CHANGED: probe frame built like the reference (screen axes projected perpendicular to the probe's view ray),
    // computed once per probe. In +z-forward space, moving along screen x/y on the z = 1 plane moves along
    // exactly (1,0,0) / (0,1,0), so no matrices are needed.
    float3 f = normalize(ReconstructPositionVS(probeCenterUV, 1.0f));   // probe view ray, +z forward
    float3 rightC = normalize(float3(1.0f, 0.0f, 0.0f) - f.x * f);
    float3 upC = normalize(float3(0.0f, 1.0f, 0.0f) - f.y * f);

    // CHANGED: near-field hands over to cascade 0 exactly where cascade 0 starts (1 probe spacing, in pixels).
    // Before: [1, 2 * _RayScale] pixels, which leaves a gap when cascade 0 spacing is > 2 pixels.
    float cascade0StartPx = _ScreenSize.x * _NextProbesCount.z * _RayScale;

    half4 sh0 = 0.0f;
    half4 shX = 0.0f;
    half4 shY = 0.0f;
    half4 shZ = 0.0f;

    for (int rayId = 0; rayId < 4; rayId++)
    {
        float4x4 tracedRadiance = 0.0f;
        {
            BitmaskTracingArgs args;
            args.probeDepth = probeDepth - 0.01f;
            args.probeUV = probeCenterUV;
            args.depthSlope = probeDepthSlope;
            // CHANGED: same thickness as the cascades (was 5.0); reference uses one thickness for both passes.
            args.depthThickness = 20.0f;
            args.tracingRange = float2(1.0f, max(cascade0StartPx, 2.0f));
            args.stepSize = 1.0f * _RayScale;
            args.texelSize = _ScreenSize.zwxy;
            sincos((rayId + 0.5f) * 0.25f * TWO_PI, args.rayDirection.y, args.rayDirection.x);
            RayTracing_Bitmask(args, tracedRadiance);
        }

        half4x4 mergedRadiances[2];
        mergedRadiances[0] = mergedRadiances[1] = 0.0h;

        for (int depthLayerId = 0; depthLayerId < 2; ++depthLayerId)
        {
            for (int depthSectorId = 0; depthSectorId < 4; depthSectorId++)
            {
                int2 cascadeBaseOffset = int2(
                    depthLayerId * halfBufferWidth + rayId * nextCascadeSize.x,
                    (4 + depthSectorId) * nextCascadeSize.y
                );

                mergedRadiances[depthLayerId][depthSectorId] =
                    GetRadianceWeighted(nextProbeLocalId, cascadeBaseOffset, bilinearWeights);
            }
        }

        UNITY_UNROLL for (int depthSectorId = 0; depthSectorId < 4; depthSectorId++)
        {
            float4 mergedRadianceMin = mergedRadiances[0][depthSectorId];
            float4 mergedRadianceMax = mergedRadiances[1][depthSectorId];
            float4 mergedRadiance = lerp(mergedRadianceMin, mergedRadianceMax, depthLerp);

            float4 radiance = tracedRadiance[depthSectorId];
            radiance.rgb += mergedRadiance.rgb * radiance.a;
            radiance.a *= mergedRadiance.a;

            // CHANGED: probe-local bin direction -> world.
            // l: probe-local, +z = towards the camera (sector 0), see GetRayDirectionVS.
            float3 l = GetRayDirectionVS(int2(rayId, depthSectorId), 0);
            // local -> +z-forward view space: x = right, y = up, towards-camera axis = -f.
            float3 dirC = rightC * l.x + upC * l.y - f * l.z;
            // +z-forward -> Unity view space (-z forward), then to world.
            float3 rayVS = float3(dirC.x, dirC.y, -dirC.z);
            float3 rayWS = mul((float3x3)_ViewToWorld, rayVS);

            sh0 += radiance * kSHBasis0;
            shX += radiance * rayWS.x * kSHBasis1;
            shY += radiance * rayWS.y * kSHBasis1;
            shZ += radiance * rayWS.z * kSHBasis1;
        }
    }

    const float binSolidAngle = FOUR_PI / 16.0f;
    _RadianceSH[coords]                           = sh0 * binSolidAngle;
    _RadianceSH[coords + int2(_CascadeSize.x, 0)] = shX * binSolidAngle;
    _RadianceSH[coords + int2(0, _CascadeSize.y)] = shY * binSolidAngle;
    _RadianceSH[coords + int2(_CascadeSize.xy)]   = shZ * binSolidAngle;
}
