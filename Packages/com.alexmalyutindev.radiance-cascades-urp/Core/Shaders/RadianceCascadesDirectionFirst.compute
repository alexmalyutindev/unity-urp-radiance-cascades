#pragma kernel RenderAndMergeCascade
#pragma kernel CombineSH

#include "Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/SphericalHarmonics.hlsl"

// #define SIMPLE_RAYCASTING
#define SMALL_FLT 1e-6

// Input
float _RayScale;
float _CascadeLevel;
float2 _ProbesCount;
float2 _CascadeSize;

float2 _UpperCascadeSize;
float2 _UpperProbesCount;

float2 _VarianceDepthSize;
float4x4 _InvProjectionMatrix;

Texture2D<float2> _MinMaxDepth;
Texture2D<float> _SmoothedDepth;

SAMPLER(sampler_VarianceDepth);
Texture2D<float2> _VarianceDepth;
SAMPLER(sampler_BlurredColor);
Texture2D<float4> _BlurredColor;

/////////////
// Outputs //
/////////////

// Cascade Layout:
// Columns - longitudinal rays
// Rows - latitudinal rays
//            min probes                      max probes
// ._______________________________v_______________________________.
// |   ↗   |   ↖   |   ↙   |   ↘   |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|_______|_______|_______|_______|
// |   ↗   |   ↖   |   ↙   |   ↘   |   ↗   |   ↖   |   ↙   |   ↘   |
// |_______|_______|_______|_______|_______|_______|_______|_______|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
// |_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|_↗_|_↑_|_↖_|_←_|_↙_|_↓_|_↘_|_↗_|
RWTexture2D<float4> _RadianceCascades;

// Output
// ._____________.
// | SH0  | SH1x |
// |______|______|
// | SH1y | SH1z |
// |______|______|
RWTexture2D<float4> _RadianceSH;

static const int2 Ranges2[6] =
{
    int2(0, 1),
    int2(1, 2),
    int2(2, 4),
    int2(4, 8),
    int2(8, 16),
    int2(16, 32),
};

static const int2 Ranges4[6] =
{
    int2(0, 1),
    int2(1, 4),
    int2(4, 16),
    int2(16, 64),
    int2(64, 256),
    int2(256, 1024),
};


///////////////
/// TRACING ///
///////////////

float2 GetDepthMoments(float2 uv)
{
    return SAMPLE_TEXTURE2D_LOD(_VarianceDepth, sampler_VarianceDepth, uv, _CascadeLevel).xy;
}
float3 GetSceneLighting(float2 uv)
{
    return SAMPLE_TEXTURE2D_LOD(_BlurredColor, sampler_BlurredColor, uv, _CascadeLevel + 2).rgb;
}
float3 GetSceneLighting(float2 uv, int lod)
{
    return SAMPLE_TEXTURE2D_LOD(_BlurredColor, sampler_BlurredColor, uv, _CascadeLevel + lod).rgb;
}
#include "Raytracing.hlsl"

///////////////

inline float2 TransformViewToScreenUV(float3 positionVS)
{
    float4 positionCS = mul(_ViewToHClip, float4(positionVS, 1));
    positionCS.xyz /= positionCS.w;
    positionCS.xy = mad(positionCS.xy, float2(0.5f, 0.5f), float2(0.5f, 0.5f));
    return positionCS.xy;
}

float4 GetRadianceWeighted(int2 coords, float4 weights)
{
    float4 a = _RadianceCascades[coords];
    float4 b = _RadianceCascades[coords + int2(1, 0)];
    float4 c = _RadianceCascades[coords + int2(0, 1)];
    float4 d = _RadianceCascades[coords + int2(1, 1)];
    return a * weights.x
        + b * weights.y
        + c * weights.z
        + d * weights.w;
}


inline float4 GetRadianceWeightedSafe(int2 coords, int2 offset, float4 weights)
{
    // TODO: Optimize boundary check!
    const int2 insideBounds = coords < floor(_UpperProbesCount - 1);
    float4 a = _RadianceCascades[coords + offset];
    float4 b = _RadianceCascades[coords + int2(1, 0) * insideBounds + offset];
    float4 c = _RadianceCascades[coords + int2(0, 1) * insideBounds + offset];
    float4 d = _RadianceCascades[coords + int2(1, 1) * insideBounds + offset];

    return a * weights.x
        + b * weights.y
        + c * weights.z
        + d * weights.w;
}

float4x4 LoadUpperCascadesBilinear(int2 coords, float4 weights)
{
    // TODO: Add boundary check!
    float4 a = _RadianceCascades[coords];
    float4 b = _RadianceCascades[coords + int2(1, 0)];
    float4 c = _RadianceCascades[coords + int2(0, 1)];
    float4 d = _RadianceCascades[coords + int2(1, 1)];
    return float4x4(
        a * weights.x,
        b * weights.y,
        c * weights.z,
        d * weights.w
    );
}

float4 LoadUpperRadianceBilateral(
    int2 coords,
    float hiDepth_min, float hiDepth_max,
    out float4 minProbeRadiance,
    out float4 maxProbeRadiance
)
{
    // ._______.
    // | c | d |
    // |___|___|
    // |[a]| b |
    // |___|___|
    static const int2 neighbours[4] = {int2(0, 0), int2(1, 0), int2(0, 1), int2(1, 1)};

    // TODO: Add ProbesCount to clip padding
    const int2 lowCascadeSize = floor(_UpperCascadeSize); // floor(_CascadeSize * 0.5f);
    int2 hiProbeId = coords % _CascadeSize; // NOTE: Wrap coords to cascade area with padding

    float2 lowProbeLocalCoords = (hiProbeId - 1.0f) * 0.5f;
    int2 lowProbeLocalId = max(int2(0, 0), (hiProbeId - int2(1, 1)) / 2);

    float2 bilinearOffsets = saturate(fmod(lowProbeLocalCoords, 1.0f) + 0.25f);
    float4 bilinearWeights = float4(bilinearOffsets, 1.0f - bilinearOffsets);
    bilinearWeights = float4(
        bilinearWeights.z * bilinearWeights.w,
        bilinearWeights.x * bilinearWeights.w,
        bilinearWeights.z * bilinearWeights.y,
        bilinearWeights.x * bilinearWeights.y
    );

    // 02----12----22----32----42----42
    // | D01 |     | E11 |     | F21 |
    // 02----12----22----32----42----42
    // |     |     |     |     |     |
    // 01----11----21----31----41----41
    // | A00 |     | B10 |     | C20 |
    // 00----10----20----30----40----40
    int2 lowCascadeCoords = coords / 2;
    lowCascadeCoords = floor(lowCascadeCoords / float2(lowCascadeSize)) * lowCascadeSize;
    lowCascadeCoords.x *= 2;
    lowCascadeCoords.y += lowCascadeSize.y * 4;

    // TODO: Remove hardcode!
    int depthLevel = _CascadeLevel + 2;
    float4 lowDepthABCD_min;
    float4 lowDepthABCD_max;
    UNITY_UNROLL for (int i = 0; i < 4; i++)
    {
        int2 c = min(lowProbeLocalId + neighbours[i], lowCascadeSize - int2(1, 1));
        float2 depthSample = LOAD_TEXTURE2D_LOD(_MinMaxDepth, c, depthLevel);
        lowDepthABCD_min[i] = depthSample.x;
        lowDepthABCD_max[i] = depthSample.y;
    }

    float4 probeWeights_min = exp2(-20.0h * abs(hiDepth_min - lowDepthABCD_min)) * bilinearWeights;
    probeWeights_min = saturate(probeWeights_min / dot(1.0f, probeWeights_min));

    float4 probeWeights_max = exp2(-20.0h * abs(hiDepth_max - lowDepthABCD_max)) * bilinearWeights;
    probeWeights_max = saturate(probeWeights_max / dot(1.0f, probeWeights_max));

    if (coords.x > _ProbesCount.x / 2)
    {
        probeWeights_min = bilinearWeights;
        probeWeights_max = bilinearWeights;
    }

    // NOTE: Angular 
    int2 offset = int2(lowCascadeSize.x, 0);
    int halfCascadeBufferSizeX = floor(_CascadeBufferSize.x / 2);
    int2 neighbourRaysOffset[4] = {
        -offset + int2(halfCascadeBufferSizeX, 0) * (lowCascadeCoords.x < offset.x),
        int2(0, 0),
        offset,
        2 * offset - int2(halfCascadeBufferSizeX, 0) * (lowCascadeCoords.x + offset.x > halfCascadeBufferSizeX),
    };

    // TODO: Interpolate min/max radiance by depth?
    float4 rayWeights = 0.5f; // float4(1.0f, 3.0f, 3.0f, 1.0f) / 8.0f;
    minProbeRadiance = 0.0f;
    maxProbeRadiance = 0.0f;
    UNITY_UNROLL for (int rayI = 1; rayI < 3; rayI++)
    {
        int2 offset_min = lowCascadeCoords + neighbourRaysOffset[rayI];
        float4 minProbeSample = GetRadianceWeightedSafe(lowProbeLocalId, offset_min, probeWeights_min);

        int2 offset_max = lowCascadeCoords + neighbourRaysOffset[rayI] + int2(halfCascadeBufferSizeX, 0);
        float4 maxProbeSample = GetRadianceWeightedSafe(lowProbeLocalId, offset_max, probeWeights_max);

        minProbeRadiance += minProbeSample * rayWeights[rayI];
        maxProbeRadiance += maxProbeSample * rayWeights[rayI];
    }

    float4 test = _RadianceCascades[lowCascadeCoords];
    test = abs(lowDepthABCD_min - hiDepth_min);
    return test;
}

[numthreads(8, 4, 1)]
void RenderAndMergeCascade(uint3 id : SV_DispatchThreadID)
{
    int2 coords = int2(id.xy);
    int2 targetCoords = int2(id.xy);

    // NOTE: Drop thread outside of cascade area. 
    if (coords.x * 2 >= _CascadeBufferSize.x || coords.y >= _CascadeSize.y)
    {
        _RadianceCascades[targetCoords + _CascadeSize.y * 7] = float4(1, 0, 1, 0);
        return;
    }

    // NOTE: Offsetting coords to top
    targetCoords.y += _CascadeSize.y * 7;

    int2 probeCenterCoord = coords % int2(_CascadeSize);
    // NOTE: Drop threads outside of cascade probes count.
    if (any(probeCenterCoord.xy >= int2(_ProbesCount.xy)))
    {
        _RadianceCascades[targetCoords] = float4(1, 0, 1, 0);
        return;
    }

    float2 probeCenterUV = saturate(float2(probeCenterCoord + 0.5f) / _ProbesCount);

    const float cascadeLevel = _CascadeLevel;
    float2 probeMinMaxDepth = LOAD_TEXTURE2D_LOD(_MinMaxDepth, probeCenterCoord, _CascadeLevel + 1).xy;

    // Clipping
    // if (probeMinMaxDepth.y > _ProjectionParams.z * 0.95f)
    // {
    //     for (int depthRayId = 0; depthRayId < 4; depthRayId++)
    //     {
    //         int2 finalCoords = targetCoords;
    //         finalCoords.y -= _ProbesCount.y * depthRayId;
    //         _RadianceCascades[finalCoords] = float4(0,0,0,1); // MinDepthProb
    //         finalCoords.x += _CascadeBufferSize.x / 2;
    //         _RadianceCascades[finalCoords] = float4(0,0,0,1); // MaxDepthProbe
    //     }
    //     return;
    // }

    float2 rayDirectionUV;
    {
        // TODO: Fix hardcoded values.
        float cascadeFactor = pow(2.0f, cascadeLevel);
        float radialRaysCount = 8.0f * cascadeFactor;
        // TODO: Fill _CascadeBufferSize.zw with 1/texelSize!!! 
        float angleId = floor(coords.x * radialRaysCount / _CascadeBufferSize.x);

        float noise = InterleavedGradientNoise(coords.xy, 0) - 0.5f;
        // angleId += noise;
        
        float deltaPhi = TWO_PI * pow(0.5f, cascadeLevel) * 0.25f;
        sincos((angleId + 0.5f) * deltaPhi, rayDirectionUV.y, rayDirectionUV.x);
    }

    float4x4 minProbeRadiance;
    float4x4 maxProbeRadiance;

    int2 range = int2(pow(2.0f, cascadeLevel) - 1.0f, pow(2.0f, cascadeLevel + 1.0f) + 1.0f);
    // range = int2(cascadeLevel * 4, (cascadeLevel + 1) * 4 + 1);

    float4 outputSizeTexel = float4(_ProbesCount, 1.0f / _ProbesCount); 
    float cascadeExponent = 0.25f * pow(2.0f, _CascadeLevel);
    half4 test = ComputeProbeRadiance(
        probeMinMaxDepth,
        probeCenterUV,
        rayDirectionUV,
        range,
        outputSizeTexel,
        cascadeExponent,
        minProbeRadiance,
        maxProbeRadiance
    );

    if (_CascadeLevel < 5)
    {
        UNITY_UNROLL
        for (int depthRayId = 0; depthRayId < 4; depthRayId++)
        {
            // TODO: Merge Depth Rays!
            int2 upperRadianceCoord = coords + int2(0, _CascadeSize.y * (3 - depthRayId));

            float4 upperMinProbeRadiance, upperMaxProbeRadiance;
            // BUG: LoadUpperRadianceBilateral incorrect weights!
            // BUG: Fix sampling outside probes area!
            float4 test2 = LoadUpperRadianceBilateral(
                upperRadianceCoord,
                probeMinMaxDepth.x,
                probeMinMaxDepth.y,
                upperMinProbeRadiance,
                upperMaxProbeRadiance
            );

            if (_CascadeLevel == 0 && depthRayId == 2)
            {
                // _RadianceCascades[targetCoords] = test2;
                // _RadianceCascades[targetCoords] = upperMinProbeRadiance;
                // _RadianceCascades[targetCoords + int2(_CascadeBufferSize.x / 2, 0)] = upperMaxProbeRadiance;
                // return;
            }

            // Min probe
            float4 currentRadiance = minProbeRadiance[depthRayId];
            currentRadiance.a = saturate(currentRadiance.a);
            minProbeRadiance[depthRayId].rgb = currentRadiance.rgb + upperMinProbeRadiance.rgb * currentRadiance.a;
            minProbeRadiance[depthRayId].a = currentRadiance.a * saturate(upperMinProbeRadiance.a);

            // Max probe
            currentRadiance = maxProbeRadiance[depthRayId];
            currentRadiance.a = saturate(currentRadiance.a);
            maxProbeRadiance[depthRayId].rgb = currentRadiance.rgb + upperMaxProbeRadiance.rgb * currentRadiance.a;
            maxProbeRadiance[depthRayId].a = currentRadiance.a * saturate(upperMaxProbeRadiance.a);
        }
    }

    for (int depthRayId = 0; depthRayId < 4; depthRayId++)
    {
        int2 finalCoords = targetCoords;
        finalCoords.y -= _CascadeSize.y * depthRayId;
        _RadianceCascades[finalCoords] = minProbeRadiance[depthRayId]; // MinDepthProbe
        
        finalCoords.x += _CascadeBufferSize.x / 2;
        _RadianceCascades[finalCoords] = maxProbeRadiance[depthRayId]; // MaxDepthProbe
    }
}


[numthreads(8, 4, 1)]
void CombineSH(uint3 id : SV_DispatchThreadID)
{
    // TODO: Add tracing!
    int2 coords = id.xy;
    if (any(coords.xy >= int2(_ProbesCount.xy * 2)))
    {
        _RadianceSH[coords] = float4(0, 0, 0, 0);
        return;
    }

    // NOTE: _ProbesCount is probes count of upper cascade!
    int2 upperCascadeSize = _CascadeSize;
    // NOTE: _CascadeSize is size of upper cascade!
    int2 lowerProbeId = coords % (_CascadeSize * 2);

    // | c | d |
    // |___|___|
    // |[a]| b |
    // |___|___|
    int2 upperProbeLocalId = clamp(floor((lowerProbeId - 1) * 0.5f), 0, upperCascadeSize - 2);

    float2 bilinearOffsets = saturate(fmod((lowerProbeId - 1) * 0.5f, 1.0f) + 0.25f);
    float4 bilinearWeights = float4(bilinearOffsets, 1.0f - bilinearOffsets);
    bilinearWeights = float4(
        bilinearWeights.z * bilinearWeights.w,
        bilinearWeights.x * bilinearWeights.w,
        bilinearWeights.z * bilinearWeights.y,
        bilinearWeights.x * bilinearWeights.y
    );

    float2 weightedMinMaxDepth = 0.0f;
    float2 minMax2x2 = float2(10000.0f, 0.0f);
    for (uint i = 0; i < 4; i++)
    {
        int2 offset = int2(i % 2, i / 2);
        float2 minMaxDepth = LOAD_TEXTURE2D_LOD(_MinMaxDepth, upperProbeLocalId + offset, 1);
        weightedMinMaxDepth += minMaxDepth * bilinearWeights[i];
        minMax2x2 = float2(min(minMax2x2.x, minMaxDepth.x), max(minMax2x2.y, minMaxDepth.y));
    }

    float2 depthMoments = GetDepthMoments(coords / (2 * _ProbesCount.xy - 0.0f));
    float midDepth = depthMoments.x + sqrt(max(0.0f, depthMoments.y - depthMoments.x * depthMoments.x));

    // _RadianceSH[coords] = float4(midDepth.xxx, 0);
    // return;
    
    // float depthThickness = max(weightedMinMaxDepth.y - weightedMinMaxDepth.x, 0.001f);
    float depthThickness = max(abs(minMax2x2.x - minMax2x2.y), 0.00001f);
    float depthWeight = saturate((weightedMinMaxDepth.y - midDepth) / depthThickness);

    float4 sh0 = 0.0f;
    float4 sh1 = 0.0f;
    float4 sh2 = 0.0f;
    float4 sh3 = 0.0f;

    int2 upperCascadeCoords = upperProbeLocalId;
    upperCascadeCoords.y += upperCascadeSize.y * 7;

    for (int y = 0; y < 4; y++)
    {
        for (int x = 0; x < 4; x++)
        {
            // Sample radiance trilinear (uv, depth). 
            int2 upperCoords = upperCascadeCoords + int2(x, -y) * upperCascadeSize;
            float4 radianceMin = 0.0f;
            radianceMin += _RadianceCascades[upperCoords] * bilinearWeights.x;
            radianceMin += _RadianceCascades[upperCoords + int2(1, 0)] * bilinearWeights.y;
            radianceMin += _RadianceCascades[upperCoords + int2(0, 1)] * bilinearWeights.z;
            radianceMin += _RadianceCascades[upperCoords + int2(1, 1)] * bilinearWeights.w;

            upperCoords.x += 4 * upperCascadeSize.x;
            float4 radianceMax = 0.0f;
            radianceMax += _RadianceCascades[upperCoords] * bilinearWeights.x;
            radianceMax += _RadianceCascades[upperCoords + int2(1, 0)] * bilinearWeights.y;
            radianceMax += _RadianceCascades[upperCoords + int2(0, 1)] * bilinearWeights.z;
            radianceMax += _RadianceCascades[upperCoords + int2(1, 1)] * bilinearWeights.w;

            float4 radiance = lerp(radianceMin, radianceMax, depthWeight);
            // radiance.rgb *= saturate(radiance.a);

            float3 direction = normalize(GetRayDirectionDFWS(int2(x, y), 0));

            sh0 += radiance * kSHBasis0;
            sh1 += radiance * direction.x * kSHBasis1;
            sh2 += radiance * direction.y * kSHBasis1;
            sh3 += radiance * direction.z * kSHBasis1;
        }
    }

    _RadianceSH[coords + int2(0, 1) * _CascadeSize * 2] = sh0;
    _RadianceSH[coords + int2(1, 1) * _CascadeSize * 2] = sh1;
    _RadianceSH[coords + int2(0, 0) * _CascadeSize * 2] = sh2;
    _RadianceSH[coords + int2(1, 0) * _CascadeSize * 2] = sh3;
}
